<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_background" android:scaleType="fitXY" android:importantForAccessibility="no" />
<LinearLayout
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">
    <ImageView android:id="@+id/widget_art" android:layout_width="48dp" android:layout_height="48dp"
        android:src="@drawable/widget_music_placeholder" android:scaleType="centerCrop" android:contentDescription="@string/widget_open" />
    <LinearLayout android:id="@+id/widget_info" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="4dp">
        <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="SillyPlayer" android:textColor="#cdd6f4" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/widget_preview_artist" android:textColor="#cdd6f4" android:alpha="0.75" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <!-- RemoteViews inflates framework ImageButtons, so framework tint is required. -->
    <ImageButton tools:ignore="UseAppTint" android:id="@+id/widget_previous" android:layout_width="40dp" android:layout_height="48dp" android:padding="9dp"
        android:src="@drawable/ic_skip_back" android:tint="#cba6f7" android:background="@android:color/transparent" android:contentDescription="@string/widget_previous" />
    <!-- RemoteViews inflates framework ImageButtons, so framework tint is required. -->
    <ImageButton tools:ignore="UseAppTint" android:id="@+id/widget_play" android:layout_width="44dp" android:layout_height="48dp" android:padding="9dp"
        android:src="@drawable/ic_play" android:tint="#cba6f7" android:background="@android:color/transparent" android:contentDescription="@string/widget_play" />
    <!-- RemoteViews inflates framework ImageButtons, so framework tint is required. -->
    <ImageButton tools:ignore="UseAppTint" android:id="@+id/widget_next" android:layout_width="40dp" android:layout_height="48dp" android:padding="9dp"
        android:src="@drawable/ic_skip_forward" android:tint="#cba6f7" android:background="@android:color/transparent" android:contentDescription="@string/widget_next" />
</LinearLayout>

</FrameLayout>
